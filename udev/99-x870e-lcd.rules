# ASUS ROG Crosshair X870E Extreme 5-inch Motherboard LCD Panel
# Grants user access to raw USB and hidraw devices without requiring root/sudo

# USB Device (for Bulk endpoint image transfer)
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="1c83", MODE="0666", TAG+="uaccess"

# HID Device (for command/control channel)
KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1c83", MODE="0666", TAG+="uaccess"
